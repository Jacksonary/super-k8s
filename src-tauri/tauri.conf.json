{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "super-k8s",
  "version": "0.1.0",
  "identifier": "com.jacksonary.super-k8s",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Super K8s",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_YOUR_MINISIGN_PUBKEY",
      "endpoints": [
        "https://github.com/Jacksonary/super-k8s/releases/latest/download/latest.json"
      ]
    }
  }
}
